[Unit]
Description=Refresh the Gildra and Server code graphs atomically
OnFailure=gildra-notify@%p.service
Wants=network-online.target
After=network-online.target
ConditionPathExists=/usr/local/lib/gildra-graph/refresh-graph-site.sh
ConditionPathExists=/usr/local/lib/gildra-graph/venv/bin/graphify
ConditionPathIsDirectory=/opt/gildra/static/graph

[Service]
Type=oneshot
User=gildra-graph
Group=gildra-graph
WorkingDirectory=/var/lib/gildra-graph
StateDirectory=gildra-graph
RuntimeDirectory=gildra-graph
Environment=GIT_TERMINAL_PROMPT=0
Environment=ALLOW_TEST_REPOSITORIES=0
ExecStart=/usr/local/lib/gildra-graph/refresh-graph-site.sh
TimeoutStartSec=45m
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
IOWeight=25
CPUQuota=300%
MemoryHigh=3G
MemoryMax=6G
TasksMax=128
UMask=0022
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
BindPaths=/opt/gildra/static/graph:/var/lib/gildra-graph/site
ReadWritePaths=/var/lib/gildra-graph/site

[Install]
WantedBy=multi-user.target
