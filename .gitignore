# Local Ansible inventory and runtime data
ansible/inventories/*/hosts.yml
ansible/inventories/*/host_vars/
ansible/inventories/*/group_vars/*.vault.yml
*.retry

# Runtime environment and secret material
.env
compose/.env
secrets/*
!secrets/*.example
!secrets/README.md

# Generated evidence may contain host metadata
artifacts/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
